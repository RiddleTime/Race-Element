    <controls:ColorZone Name="TopMenuBar" VerticalAlignment="Center" HorizontalAlignment="Stretch"
          DockPanel.Dock="Top" assist:ShadowAssist.ShadowDepth="Depth3"
          Height="60" Mode="Standard" Background="Transparent" ZIndex="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left-aligned buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0">
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Overlays"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Overlays}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Overlays}"
            Command="{Binding NavigateToOverlaysPageCommand}">
            <Image UseLayoutRounding="False" Width="32" Height="32">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource OverlayIcon}" />
              </Image.Source>
            </Image>
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Your Data"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Data}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Data}"
            Command="{Binding NavigateToDataPageCommand}">
            <Image UseLayoutRounding="False" Width="32" Height="32">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource DataIcon}" />
              </Image.Source>
            </Image>
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Setups"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Setups}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Setups}"
            Command="{Binding NavigateToSetupsPageCommand}">
            <Image UseLayoutRounding="False" Width="32" Height="32">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource SetupsIcon}" />
              </Image.Source>
            </Image>
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Liveries"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Liveries}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Liveries}"
            Command="{Binding NavigateToLiveriesPageCommand}">
            <Image UseLayoutRounding="False" Width="32" Height="32">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource LiveryIcon}" />
              </Image.Source>
            </Image>
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Tool Box"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Tools}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Tools}"
            Command="{Binding NavigateToToolsPageCommand}">
            <Image UseLayoutRounding="False" Width="32" Height="32">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource ToolsIcon}" />
              </Image.Source>
            </Image>
          </Button>
        </StackPanel>

        <!-- Right-aligned buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1">
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="Settings"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource SettingsIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="About"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource InfoIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="Minimize"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource MinimizeIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="Close"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3"
                                   Command="{Binding CloseApplicationCommand}">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource CloseIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
        </StackPanel>
      </Grid>
    </controls:ColorZone>
  </DockPanel>
</UserControl>
