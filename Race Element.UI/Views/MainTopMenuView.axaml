        <GeometryDrawing x:Key="InfoIcon"     Brush="White" Geometry="M14,2 C20.6274,2 26,7.37258 26,14 C26,20.6274 20.6274,26 14,26 C7.37258,26 2,20.6274 2,14 C2,7.37258 7.37258,2 14,2 Z M14,3.5 C8.20101,3.5 3.5,8.20101 3.5,14 C3.5,19.799 8.20101,24.5 14,24.5 C19.799,24.5 24.5,19.799 24.5,14 C24.5,8.20101 19.799,3.5 14,3.5 Z M14,11 C14.3796833,11 14.6934889,11.2821653 14.7431531,11.6482323 L14.75,11.75 L14.75,19.25 C14.75,19.6642 14.4142,20 14,20 C13.6203167,20 13.3065111,19.7178347 13.2568469,19.3517677 L13.25,19.25 L13.25,11.75 C13.25,11.3358 13.5858,11 14,11 Z M14,7 C14.5523,7 15,7.44772 15,8 C15,8.55228 14.5523,9 14,9 C13.4477,9 13,8.55228 13,8 C13,7.44772 13.4477,7 14,7 Z" />
        <GeometryDrawing x:Key="MinimizeIcon" Brush="White" Geometry="M4.25,15 L12.25,15 C12.6296958,15 12.943491,15.2821539 12.9931534,15.6482294 L13,15.75 L13,23.75 C13,24.1642136 12.6642136,24.5 12.25,24.5 C11.8703042,24.5 11.556509,24.2178461 11.5068466,23.8517706 L11.5,23.75 L11.5,17.56 L3.53033009,25.5303301 C3.23743687,25.8232233 2.76256313,25.8232233 2.46966991,25.5303301 C2.20340335,25.2640635 2.1791973,24.8473998 2.39705176,24.5537883 L2.46966991,24.4696699 L10.438,16.5 L4.25,16.5 C3.87030423,16.5 3.55650904,16.2178461 3.50684662,15.8517706 L3.5,15.75 C3.5,15.3703042 3.78215388,15.056509 4.14822944,15.0068466 L4.25,15 L12.25,15 L4.25,15 Z M25.5303301,2.46966991 C25.7965966,2.73593648 25.8208027,3.15260016 25.6029482,3.44621165 L25.5303301,3.53033009 L17.56,11.5 L23.75,11.5 C24.1296958,11.5 24.443491,11.7821539 24.4931534,12.1482294 L24.5,12.25 C24.5,12.6296958 24.2178461,12.943491 23.8517706,12.9931534 L23.75,13 L15.75,13 C15.3703042,13 15.056509,12.7178461 15.0068466,12.3517706 L15,12.25 L15,4.25 C15,3.83578644 15.3357864,3.5 15.75,3.5 C16.1296958,3.5 16.443491,3.78215388 16.4931534,4.14822944 L16.5,4.25 L16.5,10.438 L24.4696699,2.46966991 C24.7625631,2.1767767 25.2374369,2.1767767 25.5303301,2.46966991 Z" />
        <GeometryDrawing x:Key="CloseIcon"    Brush="White" Geometry="M18.2929,4.8694 C22.2336,6.54125 25,10.4467 25,15 C25,21.0751 20.0751,26 14,26 C7.92487,26 3,21.0751 3,15 C3,10.4467 5.76636,6.54125 9.70708,4.8694 C10.0884,4.70762 10.5287,4.8856 10.6904,5.26691 C10.8522,5.64823 10.6742,6.08849 10.2929,6.25027 C6.88678,7.69533 4.5,11.0698 4.5,15 C4.5,20.2467 8.75329,24.5 14,24.5 C19.2467,24.5 23.5,20.2467 23.5,15 C23.5,11.0698 21.1132,7.69533 17.7071,6.25027 C17.3258,6.08849 17.1478,5.64823 17.3096,5.26691 C17.4713,4.8856 17.9116,4.70762 18.2929,4.8694 Z M14,2 C14.4142,2 14.75,2.33579 14.75,2.75 L14.75,12.25 C14.75,12.6642 14.4142,13 14,13 C13.5858,13 13.25,12.6642 13.25,12.25 L13.25,2.75 C13.25,2.33579 13.5858,2 14,2 Z" />
      </Style.Resources>
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="true">
    <controls:ColorZone Name="TopMenuBar" VerticalAlignment="Center" HorizontalAlignment="Stretch"
          DockPanel.Dock="Top" assist:ShadowAssist.ShadowDepth="Depth3"
          Height="60" Mode="Standard" Background="Transparent" ZIndex="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left-aligned buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Margin="20,0,0,0">
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Overlays"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Overlays}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Overlays}"
            Command="{Binding NavigateToOverlaysPageCommand}">
            <icons:MaterialIcon Kind="Layers" Width="32" Height="32" Foreground="LightSteelBlue" />
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Your Data"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Data}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Data}"
            Command="{Binding NavigateToDataPageCommand}">
            <icons:MaterialIcon Kind="Performance" Width="32" Height="32" Foreground="LightSteelBlue" />
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Setups"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Setups}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Setups}"
            Command="{Binding NavigateToSetupsPageCommand}">
            <icons:MaterialIcon Kind="Wrench" Width="32" Height="32" Foreground="LightSteelBlue" />
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Liveries"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Liveries}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Liveries}"
            Command="{Binding NavigateToLiveriesPageCommand}">
            <icons:MaterialIcon Kind="Car" Width="32" Height="32" Foreground="LightSteelBlue" />
          </Button>
          <Button Theme="{StaticResource ButtonOutline}" Margin="4,4,4,4" VerticalAlignment="Center" Width="48" Height="48" ToolTip.Tip="Tool Box"
            BorderThickness="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Tools}"
            BorderBrush="{Binding CurrentPageName, Converter={StaticResource ActiveButtonStyler}, ConverterParameter=Tools}"
            Command="{Binding NavigateToToolsPageCommand}">
            <icons:MaterialIcon Kind="Toolbox" Width="32" Height="32" Foreground="LightSteelBlue" />
          </Button>
        </StackPanel>

        <!-- Right-aligned buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1" Margin="0,0,20,0">

          <Menu Name="GameSelectionMenu" Padding="0" Margin="0" HorizontalAlignment="Center" ToolTip.Tip="Select Game"  >
            <MenuItem Height="68" Width="68"
              FocusAdorner="{x:Null}"
              assist:MenuAssist.PopupCornerRadius="10"
              assist:MenuAssist.PopupAnchor="Bottom"
              assist:MenuAssist.PopupHorizontalOffset="-140"
              assist:MenuAssist.PopupVerticalOffset="10">

              <!-- Game Selection dropdown list with images and updates the icon of the button -->
              <MenuItem.Template>
                <ControlTemplate>
                  <Panel Width="100" Height="100">
                    <Border Name="PART_RootBorder" Width="68" Height="68" Margin="0,0,0,20" Cursor="Hand" BorderBrush="Transparent" BorderThickness="1" CornerRadius="100">
                      <Border.BoxShadow>
                        <MultiBinding Converter="{StaticResource AutoBoxShadowsConverter}" ConverterParameter="{x:Static naming:BoxShadowsStyle.Outset}">
                          <DynamicResource ResourceKey="CustomBoxShadowRadius"/>
                          <DynamicResource ResourceKey="MaterialDesignShadowLight" />
                          <DynamicResource ResourceKey="MaterialDesignShadowDark" />
                        </MultiBinding>
                      </Border.BoxShadow>
                      <Border Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="100"
                        BorderBrush="{DynamicResource MaterialDesignToolBackground}" BorderThickness="1" ClipToBounds="False">
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="100" ClipToBounds="True">
                          <Image HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" ClipToBounds="True"
                                Source="{Binding CurrentGameIconSource, Converter={StaticResource GameSelectionIconStyler}}"
                                Stretch="Uniform" Width="64" Height="64" />
                        </Border>
                      </Border>
                    </Border>
                    <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" Placement="RightEdgeAlignedTop" HorizontalOffset="-16" IsLightDismissEnabled="False"
                      IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
                      <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MenuFlyoutSeparatorColor}" BorderThickness="3"
                          Padding="0" MaxWidth="456" MinHeight="32" HorizontalAlignment="Stretch" CornerRadius="5">
                        <ScrollViewer Theme="{StaticResource FluentMenuScrollViewer}">
                          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,4,0,4" Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Panel>
                </ControlTemplate>
              </MenuItem.Template>

              <MenuItem.Styles>
                <Style Selector="MenuItem:focus /template/ Border#PART_RootBorder">
                  <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignFocus}" />
                </Style>
              </MenuItem.Styles>

              <MenuItem Name="iracing" Command="{Binding GameSelectionCommand}" CommandParameter="{Binding $self.Name}">
                <MenuItem.Icon>
                  <Image Source="avares://RaceElement.UI/Assets/iracing-list-image.jpg"
                    Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="128" MaxHeight="32"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Name="acc" Command="{Binding GameSelectionCommand}" CommandParameter="{Binding $self.Name}">
                <MenuItem.Icon>
                  <Image Source="avares://RaceElement.UI/Assets/acc-list-image.jpg"
                    Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="128" MaxHeight="32"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Name="acevo" Command="{Binding GameSelectionCommand}" CommandParameter="{Binding $self.Name}">
                <MenuItem.Icon>
                  <Image Source="avares://RaceElement.UI/Assets/acevo-list-image.jpg"
                    Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="128" MaxHeight="32"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Name="lmu" Command="{Binding GameSelectionCommand}" CommandParameter="{Binding $self.Name}">
                <MenuItem.Icon>
                  <Image Source="avares://RaceElement.UI/Assets/lmu-list-image.png"
                    Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="128" MaxHeight="32"/>
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
          </Menu>

          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="Settings"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3"
                                   Command="{Binding OpenSettingsDialog}">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource SettingsIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="About"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource InfoIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="Minimize"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3"
                                   Command="{Binding MinimizeApplicationCommand}">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource MinimizeIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
          <controls:FloatingButton Margin="4,4,4,4" ToolTip.Tip="Close"
                                   Background="LightSteelBlue" BorderBrush="White" BorderThickness="3"
                                   Command="{Binding CloseApplicationCommand}">
            <Image UseLayoutRounding="False">
              <Image.Source>
                <DrawingImage Drawing="{DynamicResource CloseIcon}" />
              </Image.Source>
            </Image>
          </controls:FloatingButton>
        </StackPanel>
      </Grid>
    </controls:ColorZone>
  </DockPanel>
</UserControl>
